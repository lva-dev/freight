Language: Cpp
Standard: Latest
ColumnLimit: 90

# Sorting Includes
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:          '(.*/)?Pch.hpp'
    CaseSensitive:  true
    Priority:       -1
    SortPriority:   -1
  - Regex:          '^<boost/'
    CaseSensitive:  false
    Priority:       1
    SortPriority:   1
  - Regex:          '^"tomlplusplus/'
    CaseSensitive:  false
    Priority:       2
    SortPriority:   2
  - Regex:          '^<gsl/'
    CaseSensitive:  false
    Priority:       3
    SortPriority:   3
  - Regex:          '^<'
    CaseSensitive:  false
    Priority:       4
    SortPriority:   4
  - Regex:          '^"Support/'
    CaseSensitive:  false
    Priority:       5
    SortPriority:   6
  - Regex:          '".*'
    CaseSensitive:  false
    Priority:       5
    SortPriority:   5
  - Regex:          '.*'
    CaseSensitive:  false
    Priority:       6
    SortPriority:   6
    
# Alignment
AlignAfterOpenBracket: false
AlignEscapedNewlines: Left
DerivePointerAlignment: false
PointerAlignment: Right
ReferenceAlignment: Left

AlignConsecutiveAssignments:
  Enabled: false
  AcrossEmptyLines: false
  AcrossComments: true
  AlignCompound: true
  AlignFunctionDeclarations: true
  AlignFunctionPointers: true
  PadOperators: false
AlignConsecutiveDeclarations:
  Enabled: false
  AcrossEmptyLines: false
  AcrossComments: true
  AlignCompound: true
  AlignFunctionDeclarations: true
  AlignFunctionPointers: true
  PadOperators: false
AlignConsecutiveMacros:
  Enabled: false
  AcrossEmptyLines: false
  AcrossComments: true
  AlignCompound: true
  AlignFunctionDeclarations: true
  AlignFunctionPointers: true
  PadOperators: false

# Packing/Bin Packing
PackConstructorInitializers: CurrentLine
BinPackLongBracedList: true
BinPackParameters: OnePerLine
BinPackArguments: false
Cpp11BracedListStyle: true

# Access Modifier Lines
EmptyLineAfterAccessModifier: Never
EmptyLineBeforeAccessModifier: Never

# Indentation
AccessModifierOffset: -4
BitFieldColonSpacing: Both
ContinuationIndentWidth: 4
IndentWidth: 4
IndentAccessModifiers: false
IndentCaseLabels: false
IndentPPDirectives: BeforeHash
IndentRequiresClause: true
IndentWrappedFunctionNames: false
TabWidth: 4
UseTab: Always

# Namespaces
AllowShortNamespacesOnASingleLine: true
NamespaceIndentation: Inner
ShortNamespaceLines: 1
WrapNamespaceBodyWithEmptyLines: Never
FixNamespaceComments: true

# Allow
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never

# Braces
InsertBraces: false
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  # AfterRequiresExpression: true
  AfterStruct: true
  AfterUnion: true
  # AfterExportBlock: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
  
# Breaks
AlwaysBreakBeforeMultilineStrings: true
BreakAdjacentStringLiterals: true
BreakAfterAttributes: Always
BreakBeforeCloseBracketBracedList: true
BreakBeforeConceptDeclarations: Always
BreakBeforeInlineASMColon: Always
BreakBeforeTemplateCloser: true
BreakBeforeTernaryOperators: true
BreakBinaryOperations: RespectPrecedence
BreakConstructorInitializers: BeforeComma
BreakFunctionDefinitionParameters: false
BreakInheritanceList: BeforeComma
BreakStringLiterals: true
BreakTemplateDeclarations: Yes
BreakAfterOpenBracketBracedList: true
SeparateDefinitionBlocks: Always

# Macros
SkipMacroDefinitionBody: true

# Spaces
SpaceAfterCStyleCast: false
SpaceAfterOperatorKeyword: false
SpaceAfterTemplateKeyword: false
SpaceAfterLogicalNot: false
SpaceBeforeRangeBasedForLoopColon: true
SpaceBeforeSquareBrackets: false
SpaceBeforeInheritanceColon: true
SpaceBeforeCpp11BracedList: true
SpaceBeforeCtorInitializerColon: true
SpaceBeforeCaseColon: false
SpaceBeforeAssignmentOperators: true
SpaceInEmptyBlock: false
SpacesInParens: Never
SpacesInAngles: Never
SpacesInSquareBrackets: false
SpacesInContainerLiterals: true